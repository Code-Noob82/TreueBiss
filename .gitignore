.kotlin/

# Datenexporte aus dem Supabase-Dashboard - enthalten Nutzer-IDs und
# gehoeren nicht ins Repository.
*_rows.csv
*_rows.sql

# Konfiguration der Kassenseite - pro Installation, nicht im Quelltext.
# Frueher ignoriert. Seit die Seiten ueber GitHub Pages ausgeliefert werden,
# muss die Konfiguration mit - und sie enthaelt nichts Geheimes: Der
# Supabase-Anon-Key steckt ohnehin in jeder ausgelieferten APK, die
# Sicherheit haengt an den RLS-Policies. Wer eine eigene Umgebung fahren
# will, ersetzt die Dateien im Build.
# web/*/config.js

# Werkzeug-Konfiguration, gehoert nicht zum Projekt
.claude/

# Manifeste je Betrieb. Entstehen beim Veroeffentlichen aus den Daten des
# Backends - eingecheckt waeren sie sofort veraltet, sobald ein Betrieb
# dazukommt oder sich umbenennt.
web/app/m/

# Zugangsdaten. Dieses Repository ist oeffentlich - ein hier abgelegter
# Dienstkonto-Schluessel waere binnen Minuten von Scannern gefunden, und ein
# Commit laesst sich nicht wirklich zuruecknehmen. Die Schluessel gehoeren in
# `supabase secrets`, nie in den Quelltext.
*service-account*.json
*service_account*.json
*-key.json
*_key.json
schluessel*.json
credentials*.json
# So benennt Google den heruntergeladenen Dienstkonto-Schluessel:
# <projekt-id>-<12 Hexzeichen>.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*.p12
*.pem
